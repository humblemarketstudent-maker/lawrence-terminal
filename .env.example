# APEX Terminal — copy to .env at the repo root. Every key is optional.
# The default path is zero-key yfinance + public FRED CSV + public RSS + SEC EDGAR.

# Quote provider: yfinance | finnhub | fmp | alphavantage | twelvedata
# Keyed providers are used for quotes when selected and a key is present.
# History, statements, and anything the keyed feed does not return fall back to yfinance.
DATA_PROVIDER=yfinance

FINNHUB_API_KEY=
FMP_API_KEY=
ALPHAVANTAGE_API_KEY=
TWELVEDATA_API_KEY=

# Optional. Without it, Treasury and macro series use FRED's public CSV endpoint.
FRED_API_KEY=

# Required by the SEC fair-access policy. Use a real contact if you raise request volume.
SEC_USER_AGENT=APEX Terminal research@apex-terminal.local

# Cache TTLs in seconds.
CACHE_TTL_QUOTES=20
CACHE_TTL_HISTORY=600
CACHE_TTL_FUNDAMENTALS=21600
CACHE_TTL_NEWS=180
CACHE_TTL_MACRO=3600
CACHE_TTL_FILINGS=3600

# Set to true to skip outbound calls and serve the snapshot/fixtures only.
APEX_DISABLE_LIVE=false
